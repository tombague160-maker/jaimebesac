# --- Authentification (obligatoire) --------------------------------------
# Email de connexion.
AUTH_EMAIL=toi@exemple.fr
# Hash du mot de passe : génère-le avec `npm run auth:hash -- "ton-mot-de-passe"`
AUTH_PASSWORD_HASH=
# Secret de signature des sessions : `openssl rand -hex 32`
SESSION_SECRET=
# Durée de session en secondes (défaut 30 jours).
SESSION_TTL_SECONDS=2592000
# Cookie de session "Secure" : true par défaut en prod. Mettre false UNIQUEMENT
# pour un accès LAN en http:// (un navigateur refuse un cookie Secure en HTTP).
# Derrière un reverse proxy HTTPS (nginx/SWAG), laisser vide/true.
# COOKIE_SECURE=false

# --- Synchronisation RSS (cron) ------------------------------------------
# Secret pour déclencher /api/news/sync sans être connecté (cron). `openssl rand -hex 32`
CRON_SECRET=
# URL de l'app pour le script `npm run news:sync` (host cron).
APP_URL=http://localhost:3000

# --- Divers ---------------------------------------------------------------
# Fuseau horaire de l'application (dates, "aujourd'hui").
NEXT_PUBLIC_APP_TIMEZONE=Europe/Paris
# Port exposé sur l'hôte (docker compose).
APP_PORT=3000
# Emplacement de la base SQLite (défini par le Dockerfile en conteneur).
DATABASE_URL=file:/data/dev.db
